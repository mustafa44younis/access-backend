    "migrate:messages": "node src/database/migrate-messages.js",
    "migrate:profile": "node src/database/migrate-profile.js",
    "migrate:disputes": "node src/database/migrate-disputes-and-withdrawals.js",
    "migrate:chat-advanced": "node src/database/migrate-chat-repository-and-voice.js",
    "migrate:security": "node src/database/migrate-security-and-kyc.js",
    "migrate:notifications": "node src/database/migrate-notifications.js",
    "migrate:all": "npm run migrate && npm run migrate:auth && npm run migrate:projects && npm run migrate:contracts && npm run migrate:smart-consultations && npm run migrate:expert-bookings && npm run migrate:payments && npm run migrate:messages && npm run migrate:profile && npm run migrate:disputes && npm run migrate:chat-advanced && npm run migrate:security && npm run migrate:notifications",
